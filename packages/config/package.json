{
  "name": "@dsfrkit/config",
  "version": "1.1.0",
  "description": "Preset Tailwind CSS pour le Système de Design de l'État français (DSFR)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "dsfr",
    "tailwindcss",
    "preset",
    "design-system",
    "france"
  ],
  "license": "ETALAB-2.0",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@dsfrkit/tokens": "workspace:*",
    "tailwindcss": ">=3.4.0"
  },
  "devDependencies": {
    "@dsfrkit/tokens": "workspace:*",
    "tailwindcss": "^3.4.19",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
